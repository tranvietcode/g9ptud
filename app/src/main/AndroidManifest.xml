<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Test3">

        <!-- LoginActivity (Launcher) -->
        <activity
            android:name=".activities.LoginActivity"
            android:exported="true"
            android:label="Đăng nhập"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- MainActivity -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:label="Trang chủ" />

        <!-- ScheduleFormActivity -->
        <activity
            android:name=".activities.ScheduleFormActivity"
            android:exported="false"
            android:label="Form Lịch học"
            android:windowSoftInputMode="adjustResize" />

        <!-- StudentActivity (Person 2 Stub) -->
        <activity
            android:name=".activities.StudentActivity"
            android:exported="false"
            android:label="Quản lý sinh viên" />

        <!-- SubjectActivity (Person 2 Stub) -->
        <activity
            android:name=".activities.SubjectActivity"
            android:exported="false"
            android:label="Quản lý môn học" />

        <!-- StudyScheduleActivity (Person 3 Stub) -->
        <activity
            android:name=".activities.StudyScheduleActivity"
            android:exported="false"
            android:label="Xem lịch học" />

        <!-- CalendarActivity (Person 3 Stub) -->
        <activity
            android:name=".activities.CalendarActivity"
            android:exported="false"
            android:label="Lịch theo ngày" />

    </application>

</manifest>
