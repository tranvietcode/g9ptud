<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
<EditText android:id="@+id/studentCode" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Mã sinh viên" android:inputType="text" android:maxLength="200"/>
<EditText android:id="@+id/fullname" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Họ tên" android:inputType="textPersonName" android:maxLength="200"/>
<EditText android:id="@+id/email" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Email" android:inputType="textEmailAddress" android:maxLength="200"/>
<EditText android:id="@+id/phone" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Số điện thoại" android:inputType="phone" android:maxLength="200"/>
<EditText android:id="@+id/username" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Tên đăng nhập" android:inputType="text" android:maxLength="200"/>
<EditText android:id="@+id/password" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Mật khẩu (ít nhất 6 ký tự)" android:inputType="textPassword" android:maxLength="200"/>
</LinearLayout></ScrollView>
